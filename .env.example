# Copy to .env; local secrets are never committed.
APP_ENV=development
API_PORT=8000
POSTGRES_PORT=15432
REDIS_PORT=16379
POSTGRES_DB=talotrace
POSTGRES_USER=talotrace
POSTGRES_PASSWORD=replace-with-random-local-password
DATABASE_URL=postgresql://talotrace:replace-with-random-local-password@127.0.0.1:15432/talotrace
REDIS_URL=redis://127.0.0.1:16379/0
MATERIALS_DIR=../material
ARTIFACTS_DIR=./data/tests
OPENAI_API_KEY=
# These model IDs were verified with the project session key; availability is account-specific.
OPENAI_DIRECTOR_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
COMFYUI_URL=http://127.0.0.1:18188
KOKORO_URL=http://127.0.0.1:18081
KOKORO_VOICE=af_heart
RUNPOD_POD_ID=
RUNPOD_SSH_HOST=
RUNPOD_SSH_PORT=
RUNPOD_SSH_USER=root
RUNPOD_SSH_KEY=.secrets/runpod_ed25519
STYLE_ANCHOR_PATH=assets/references/style_anchor.png
HAND_REFERENCE_PATH=assets/references/hand_reference.png

# Enable after Kokoro and the selected renderer are ready.
VIDEO_WORKER_ENABLED=false
# ltx: GPU-generated clips; keyframe-composite-v1: local hand/reveal composition.
VIDEO_RENDERER=ltx
VIDEO_COMFY_TIMEOUT_SECONDS=21600
VIDEO_POLL_SECONDS=5
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
